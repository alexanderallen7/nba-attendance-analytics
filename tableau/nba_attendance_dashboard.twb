    <worksheet name='Fill Rate YoY Change'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>League average fill rate &#8212; change vs previous season (2021-22 compares to 2019-20; 2020-21 excluded, COVID)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='extract' name='federated.1pt6fmd1tboxmb1fpttad1kn09nl' />
          </datasources>
      <datasource-dependencies datasource='federated.1pt6fmd1tboxmb1fpttad1kn09nl'>
        <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
        <column caption='Fill Rate' datatype='real' name='[fill_rate]' role='measure' type='quantitative' />
        <column caption='Excluded Flag' datatype='integer' name='[excluded_flag]' role='measure' type='quantitative' />
        <column caption='Included Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_IncludedFill]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [excluded_flag] = 0 THEN [fill_rate] END' />
        </column>
        <column caption='Fill Rate YoY % (table calc)' datatype='real' default-format='p0.0%' name='[Calculation_YoY]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='AVG([Calculation_IncludedFill]) / LOOKUP(AVG([Calculation_IncludedFill]), -1) - 1' />
        </column>
        <column-instance column='[Calculation_YoY]' derivation='User' name='[usr:Calculation_YoY:qk]' pivot='key' type='quantitative' />
        <column-instance column='[season]' derivation='None' name='[none:season:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
          <filter class='categorical' column='[federated.1pt6fmd1tboxmb1fpttad1kn09nl].[none:season:nk]'>
            <groupfilter function='except'>
              <groupfilter function='level-members' level='[none:season:nk]' />
              <groupfilter function='member' level='[none:season:nk]' member='&quot;2020-21&quot;' />
            </groupfilter>
          </filter>
          <aggregation value='true' />
        </view>
        <style>
        </style>
