      <aliases enabled='yes' />
      <column caption='extract.csv' datatype='table' name='[__tableau_internal_object_id__].[extract.csv_E02F911300B040E1BA8C28863C14DEC6]' role='measure' type='quantitative' />
      <column caption='Arena' datatype='string' name='[arena]' role='dimension' type='nominal' />
      <column caption='Attendance' datatype='integer' name='[attendance]' role='measure' type='quantitative' />
      <column caption='Away Team' datatype='string' name='[away_team]' role='dimension' type='nominal' />
      <column caption='Capacity' datatype='integer' name='[capacity]' role='measure' type='quantitative' />
      <column caption='Day Of Week' datatype='string' name='[day_of_week]' role='dimension' type='nominal' />
      <column caption='Excluded Flag' datatype='integer' name='[excluded_flag]' role='measure' type='quantitative' />
      <column caption='Excluded Reason' datatype='string' name='[excluded_reason]' role='dimension' type='nominal' />
      <column caption='Fill Rate' datatype='real' name='[fill_rate]' role='measure' type='quantitative' />
      <column caption='Fill Rate Raw' datatype='real' name='[fill_rate_raw]' role='measure' type='quantitative' />
      <column caption='Game Date' datatype='date' name='[game_date]' role='dimension' type='ordinal' />
      <column caption='Game Id' datatype='integer' name='[game_id]' role='dimension' type='ordinal' />
      <column caption='Home Back To Back' datatype='integer' name='[home_back_to_back]' role='measure' type='quantitative' />
      <column caption='Home Team' datatype='string' name='[home_team]' role='dimension' type='nominal' />
      <column caption='Home Win Pct Entering' datatype='real' name='[home_win_pct_entering]' role='measure' type='quantitative' />
      <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
      <column caption='Opp Win Pct Entering' datatype='real' name='[opp_win_pct_entering]' role='measure' type='quantitative' />
      <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
      <column caption='Season Start Year' datatype='integer' name='[season_start_year]' role='dimension' type='quantitative' />
      <column caption='Sellout Flag' datatype='integer' name='[sellout_flag]' role='measure' type='quantitative' />
      <column caption='Fill Rate (calc)' datatype='real' default-format='p0.0%' name='[Calculation_FillRateCalc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[attendance] / [capacity]' />
      </column>
      <column caption='Included Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_IncludedFill]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [excluded_flag] = 0 THEN [fill_rate] END' />
      </column>
      <column caption='Team Avg Fill Rate (LOD)' datatype='real' default-format='p0.0%' name='[Calculation_TeamAvgLOD]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [home_team] : AVG([Calculation_IncludedFill]) }' />
      </column>
      <column caption='Sellout % (included games)' datatype='real' default-format='p0%' name='[Calculation_SelloutPct]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [excluded_flag] = 0 THEN [sellout_flag] END)' />
      </column>
      <column caption='League Avg Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_LeagueFill]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_IncludedFill])' />
      </column>
      <column caption='Selected Team Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_TeamFill]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [home_team] = [Parameters].[Parameter 1] THEN [Calculation_IncludedFill] END)' />
      </column>
      <column caption='Selected Team Sellout %' datatype='real' default-format='p0%' name='[Calculation_TeamSellout]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [home_team] = [Parameters].[Parameter 1] AND [excluded_flag] = 0 THEN [sellout_flag] END)' />
      </column>
      <column caption='Team vs League' datatype='string' name='[Calculation_Highlight]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [home_team] = [Parameters].[Parameter 1] THEN &quot;Selected team&quot; ELSE &quot;Other teams&quot; END' />
      </column>
      <column caption='Fill Rate YoY % (table calc)' datatype='real' default-format='p0.0%' name='[Calculation_YoY]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_IncludedFill]) / LOOKUP(AVG([Calculation_IncludedFill]), -1) - 1' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
